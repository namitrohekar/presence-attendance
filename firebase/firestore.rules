rules_version = '2';

// Presence security rules.
//
// There is no server: these rules are the only verifier. A modified client can
// send any write it likes, so every invariant is enforced here and the app's
// own checks exist only to give precise messages.
//
// Anything not matched below is denied. request.time is the only clock.
// Lookup budget: no request path uses more than 4 get()/exists()/getAfter()
// calls (limit 10); the count is noted beside each write rule.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Constants -------------------------------------------------------
    // Mirror of contracts/constants.json. firebase/test/constants.test.js
    // fails if any value here drifts from that file.
    function TOKEN_VALIDITY_S() { return 20; }
    function SESSION_MIN_MIN() { return 5; }
    function SESSION_MAX_MIN() { return 180; }
    function SESSION_SKEW_MIN() { return 1; }
    function GEO_RADIUS_MIN_M() { return 30; }
    function GEO_RADIUS_MAX_M() { return 1000; }
    function MAX_ACCURACY_M() { return 50; }
    function QUEUE_GRACE_MIN() { return 30; }
    function THRESHOLD_MIN() { return 1; }
    function THRESHOLD_MAX() { return 100; }
    function NOTE_MAX_LEN() { return 140; }
    function METERS_PER_DEGREE() { return 111320; }
    function ALERT_RETENTION_DAYS() { return 90; }
    function CORRECTION_RETENTION_DAYS() { return 365; }
    function HEADCOUNT_MAX() { return 1000; }
    function NAME_MAX_LEN() { return 80; }
    function BATCH_MIN() { return 1; }
    function BATCH_MAX() { return 20; }

    // Students must sign in with an address in exactly this domain. Faculty
    // are identified by the allowlist and may use any domain.
    function STUDENT_DOMAIN() { return 'mc.vjti.ac.in'; }

    // ---- Identity (invariant 1) -----------------------------------------
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email.lower(); }

    // A Google account with a verified address. Not yet allowed to do
    // anything except report its own rejected sign-in (see identityAlerts).
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    // Exact match on the part after a single '@', so sub-domains and
    // look-alike domains fail.
    function hasStudentEmail() {
      return email().split('@').size() == 2
        && email().split('@')[1] == STUDENT_DOMAIN();
    }

    // Role is derived from the allowlist on every use; it is never read from
    // a field the client wrote.
    function isAllowlisted() {
      return exists(/databases/$(database)/documents/teacherAllowlist/$(email()));
    }

    // Who may use the app at all: allowlisted faculty, or a student address.
    // The cheap domain test runs first so students cost no lookup here. Where
    // the role matters, the allowlist takes precedence (see users).
    function signedIn() {
      return verified() && (hasStudentEmail() || isAllowlisted());
    }

    // ---- Shared validators ----------------------------------------------
    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Values that are interpolated into document paths must not contain '/'.
    function isId(v) {
      return v is string && v.matches('^[A-Za-z0-9]{1,128}$');
    }

    function isJoinCode(v) {
      return v is string && v.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$');
    }

    function isToken(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{22}$');
    }

    // An opaque institute identifier. Never decoded.
    function isRollNo(v) {
      return v is string && v.matches('^[0-9]{9}$');
    }

    function isCohort(v) {
      return v is string && v.matches('^[A-Z0-9]{2,8}$');
    }

    // A student's official name as on the class list: trimmed and not empty.
    function isName(v) {
      return isText(v, 1, NAME_MAX_LEN()) && v.trim() == v;
    }

    // A lab batch, such as 1 to 4 in the timetable.
    function isBatch(v) {
      return v is int && v >= BATCH_MIN() && v <= BATCH_MAX();
    }

    // One of the ten emojis a student is shown with, stored by its name.
    function isEmoji(v) {
      return v is string
        && v.matches('^(LION|TIGER|ELEPHANT|PANDA|FOX|OWL|DOLPHIN|TURTLE|BUTTERFLY|PEACOCK)$');
    }

    // A roster address: lower case, one '@', exactly the student domain.
    function isStudentEmail(v) {
      return v is string
        && v == v.lower()
        && v.split('@').size() == 2
        && v.split('@')[0].matches('^[a-z0-9._-]{1,64}$')
        && v.split('@')[1] == STUDENT_DOMAIN();
    }

    function hasExactly(data, fields) {
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields);
    }

    function isMemberOf(courseId, studentId) {
      return exists(/databases/$(database)/documents/memberships/$(courseId + '_' + studentId));
    }

    // Document ids of the form <prefix>_<uid> belong to that uid. Matching on
    // the id lets the owner read a document that does not exist yet and get
    // "not found" instead of a denial.
    function isOwnCompositeId(id) {
      return id.matches('^[A-Za-z0-9]+_' + uid() + '$');
    }

    // ---- Roster paths ----------------------------------------------------
    // studentRegistry/{email} is the authoritative email -> roll number map.
    // rollIndex/{cohort}_{rollNo} makes a roll number unique in its cohort.
    // The two are only ever written together.
    function rosterBase() {
      return ['email', 'rollNo', 'cohort', 'addedBy', 'addedAt', 'revision'];
    }

    // What describes the student rather than identifies them. Entries added
    // before names were kept have none; any that is present must be valid.
    function rosterDetails() {
      return ['name', 'batch', 'emoji'];
    }

    function validDetails(data) {
      return (!('name' in data) || isName(data.name))
        && (!('batch' in data) || isBatch(data.batch))
        && (!('emoji' in data) || isEmoji(data.emoji));
    }

    function rosterEntry(studentEmail) {
      return get(/databases/$(database)/documents/studentRegistry/$(studentEmail)).data;
    }

    function rosterEntryAfter(studentEmail) {
      return getAfter(/databases/$(database)/documents/studentRegistry/$(studentEmail)).data;
    }

    function rosterEntryExistsAfter(studentEmail) {
      return existsAfter(/databases/$(database)/documents/studentRegistry/$(studentEmail));
    }

    function rollIndexKey(cohort, rollNo) {
      return cohort + '_' + rollNo;
    }

    function rollIndexAfter(cohort, rollNo) {
      return getAfter(/databases/$(database)/documents/rollIndex/$(rollIndexKey(cohort, rollNo))).data;
    }

    function rollIndexExistsAfter(cohort, rollNo) {
      return existsAfter(/databases/$(database)/documents/rollIndex/$(rollIndexKey(cohort, rollNo)));
    }

    // The audit record for the next change to a roster entry has a fixed id:
    // the address, when the entry was added, and the next revision number.
    // Nothing in it comes from the client's clock, and it can only be used
    // once, so every change is paired with exactly one record.
    function correctionId(studentEmail, entry) {
      return studentEmail + '_' + string(entry.addedAt.toMillis()) + '_' + string(entry.revision + 1);
    }

    function correctionAfter(studentEmail, entry) {
      return getAfter(/databases/$(database)/documents/registryCorrections/$(correctionId(studentEmail, entry))).data;
    }

    // ---- appConfig: read by signed-in users, written from the console only
    match /appConfig/campus {
      allow get: if signedIn();
    }

    // teacherAllowlist has no match block on purpose: no client can read,
    // list or write it. Only exists() in these rules can see it.

    // ---- users (invariant 1) --------------------------------------------
    match /users/{userId} {
      function baseFields() {
        return ['name', 'email', 'role', 'createdAt'];
      }

      function tokenIdentity(data) {
        return isText(data.name, 1, 100)
          && data.name == request.auth.token.name
          && data.email == request.auth.token.email;
      }

      // The allowlist decides: an allowlisted address is faculty, whatever
      // its domain, and can never hold a student profile.
      function validFaculty(data) {
        return hasExactly(data, baseFields())
          && tokenIdentity(data)
          && data.role == 'FACULTY'
          && isAllowlisted();
      }

      // A student profile is a registration: the roll number and cohort must
      // equal the roster entry for the token's address, and that entry must
      // be claimed by this sign-in (in this same write or an earlier one).
      // The comparison is made on every write, so the roll number can only
      // change if faculty correct the roster first.
      function validStudent(data) {
        let entry = rosterEntryAfter(email());
        return hasExactly(data, baseFields().concat(['rollNo', 'cohort']))
          && tokenIdentity(data)
          && data.role == 'STUDENT'
          && hasStudentEmail()
          && !isAllowlisted()
          && entry.rollNo == data.rollNo
          && entry.cohort == data.cohort
          && entry.registeredUid == uid();
      }

      allow get: if signedIn() && uid() == userId;

      // Lookups: 2 (allowlist, roster entry).
      allow create: if signedIn()
        && uid() == userId
        && (validFaculty(request.resource.data) || validStudent(request.resource.data))
        && request.resource.data.createdAt == request.time;

      // Lookups: 2. The role is re-derived, so adding or removing an
      // allowlist entry takes effect the next time the profile is written.
      allow update: if signedIn()
        && uid() == userId
        && (validFaculty(request.resource.data) || validStudent(request.resource.data))
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---- student roster --------------------------------------------------
    match /studentRegistry/{entryEmail} {
      // A student may read their own entry and nothing else; it cannot be
      // listed by them. Faculty read and list the whole roster.
      allow get: if signedIn() && (entryEmail == email() || isAllowlisted());
      allow list: if signedIn() && isAllowlisted();

      // Lookups: 2 (allowlist, roll index after this write). The index must be
      // created in the same batch. A second write to an existing address is
      // an update, so nothing is ever silently overwritten. A new entry always
      // has the student's name and emoji; the batch is optional.
      allow create: if signedIn()
        && isAllowlisted()
        && request.resource.data.keys().hasOnly(rosterBase().concat(rosterDetails()))
        && request.resource.data.keys().hasAll(rosterBase().concat(['name', 'emoji']))
        && validDetails(request.resource.data)
        && isStudentEmail(request.resource.data.email)
        && entryEmail == request.resource.data.email
        && isRollNo(request.resource.data.rollNo)
        && isCohort(request.resource.data.cohort)
        && request.resource.data.addedBy == uid()
        && request.resource.data.addedAt == request.time
        && request.resource.data.revision == 0
        && rollIndexAfter(request.resource.data.cohort, request.resource.data.rollNo).email
            == entryEmail;

      // The student whose address this is binds the entry to their sign-in,
      // once. Lookups: 1 (allowlist: faculty never register as students).
      function isClaim() {
        return entryEmail == email()
          && hasStudentEmail()
          && !isAllowlisted()
          && !('registeredUid' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['registeredUid', 'registeredAt'])
          && request.resource.data.registeredUid == uid()
          && request.resource.data.registeredAt == request.time;
      }

      // Faculty change an existing entry only together with its audit record.
      // Every correction releases the claim, so the student registers again
      // against the corrected entry. Lookups: 4 (allowlist, audit record,
      // new index, old index).
      function isCorrection() {
        let before = resource.data;
        let after = request.resource.data;
        let record = correctionAfter(entryEmail, before);
        let changed = after.rollNo != before.rollNo || after.cohort != before.cohort;
        return isAllowlisted()
          && after.keys().hasOnly(rosterBase().concat(rosterDetails()))
          && after.keys().hasAll(rosterBase())
          && validDetails(after)
          && after.email == before.email
          && after.addedBy == before.addedBy
          && after.addedAt == before.addedAt
          && after.revision == before.revision + 1
          && isRollNo(after.rollNo)
          && isCohort(after.cohort)
          && record.correctedBy == uid()
          && record.correctedAt == request.time
          && ((record.action == 'UPDATE'
                && changed
                && rollIndexAfter(after.cohort, after.rollNo).email == entryEmail
                && !rollIndexExistsAfter(before.cohort, before.rollNo))
              || (record.action == 'RELEASE'
                && !changed
                && 'registeredUid' in before));
      }

      // Faculty fix a student's name, batch or emoji. These describe the
      // student, not their identity, so the registration stays and no audit
      // record is needed. Name and emoji stay present once set. Lookups: 1
      // (allowlist).
      function isDetailsEdit() {
        return isAllowlisted()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(rosterDetails())
          && request.resource.data.keys().hasAll(['name', 'emoji'])
          && validDetails(request.resource.data);
      }

      allow update: if signedIn() && (isClaim() || isCorrection() || isDetailsEdit());

      // Lookups: 3 (allowlist, audit record, old index).
      allow delete: if signedIn()
        && isAllowlisted()
        && correctionAfter(entryEmail, resource.data).action == 'REMOVE'
        && correctionAfter(entryEmail, resource.data).correctedBy == uid()
        && correctionAfter(entryEmail, resource.data).correctedAt == request.time
        && !rollIndexExistsAfter(resource.data.cohort, resource.data.rollNo);
    }

    match /rollIndex/{key} {
      // get only, faculty only: used to check a roll number is free. Nobody
      // can list it, and students cannot read it at all.
      allow get: if signedIn() && isAllowlisted();

      // Lookups: 2 (allowlist, roster entry after this write). A key that
      // already exists makes this an update, which fails, so a roll number
      // maps to one address per cohort.
      allow create: if signedIn()
        && isAllowlisted()
        && hasExactly(request.resource.data, ['email'])
        && isStudentEmail(request.resource.data.email)
        && key == rollIndexKey(
            rosterEntryAfter(request.resource.data.email).cohort,
            rosterEntryAfter(request.resource.data.email).rollNo);

      // Lookups: 2. Only once the roster entry no longer points here, which
      // itself requires an audited correction or removal.
      allow delete: if signedIn()
        && isAllowlisted()
        && (!rosterEntryExistsAfter(resource.data.email)
            || key != rollIndexKey(
                rosterEntryAfter(resource.data.email).cohort,
                rosterEntryAfter(resource.data.email).rollNo));
    }

    // Immutable audit trail of every change to an existing roster entry.
    match /registryCorrections/{recordId} {
      allow read: if signedIn() && isAllowlisted();

      // Lookups: 3 (allowlist, roster entry before, roster entry after). The
      // record must describe the entry as it was, and the entry must change
      // in this same batch, so a record cannot exist without its change.
      function validRecord(data) {
        let before = rosterEntry(data.email);
        return data.keys().hasOnly(
              ['email', 'action', 'reason', 'correctedBy', 'correctedAt', 'beforeRollNo',
               'beforeCohort', 'releasedUid', 'afterRollNo', 'afterCohort'])
          && data.keys().hasAll(
              ['email', 'action', 'reason', 'correctedBy', 'correctedAt', 'beforeRollNo',
               'beforeCohort'])
          && isStudentEmail(data.email)
          && recordId == correctionId(data.email, before)
          && isText(data.reason, 1, NOTE_MAX_LEN())
          && data.correctedBy == uid()
          && data.correctedAt == request.time
          && data.beforeRollNo == before.rollNo
          && data.beforeCohort == before.cohort
          && (('registeredUid' in before)
              ? data.releasedUid == before.registeredUid
              : !('releasedUid' in data))
          && ((data.action == 'REMOVE'
                && !('afterRollNo' in data)
                && !('afterCohort' in data)
                && !rosterEntryExistsAfter(data.email))
              || (data.action in ['UPDATE', 'RELEASE']
                && rosterEntryAfter(data.email).revision == before.revision + 1
                && data.afterRollNo == rosterEntryAfter(data.email).rollNo
                && data.afterCohort == rosterEntryAfter(data.email).cohort));
      }

      allow create: if signedIn() && isAllowlisted() && validRecord(request.resource.data);

      // Retention: kept for at least CORRECTION_RETENTION_DAYS, then a
      // faculty app may purge it. No update rule exists.
      allow delete: if signedIn()
        && isAllowlisted()
        && resource.data.correctedAt
            < request.time - duration.value(CORRECTION_RETENTION_DAYS(), 'd');
    }

    // ---- identity alerts -------------------------------------------------
    // Written by the account whose attempt was rejected, because nothing
    // else can observe a rejection. Every field is checked against the
    // sign-in token and the roster, so an account can only report a
    // violation that is true and is its own. Students cannot read alerts.
    match /identityAlerts/{alertId} {
      function serverDay() {
        return string(request.time.year()) + '-' + string(request.time.month())
          + '-' + string(request.time.day());
      }

      function baseFields() {
        return ['type', 'email', 'uid', 'audience', 'createdAt'];
      }

      function attemptFields() {
        return baseFields().concat(['enteredRollNo']);
      }

      // Lookups: 1 (allowlist).
      function nonVjtiEmail(data) {
        return hasExactly(data, baseFields())
          && data.audience == 'ALL'
          && !hasStudentEmail()
          && !isAllowlisted();
      }

      // Lookups: 1 (roster entry).
      function notOnRegister(data) {
        return hasExactly(data, attemptFields())
          && isRollNo(data.enteredRollNo)
          && data.audience == 'ALL'
          && hasStudentEmail()
          && !exists(/databases/$(database)/documents/studentRegistry/$(email()));
      }

      // Lookups: 1 (roster entry). Goes to the faculty member who added the
      // student.
      function rollMismatch(data) {
        return hasExactly(data, attemptFields())
          && isRollNo(data.enteredRollNo)
          && hasStudentEmail()
          && rosterEntry(email()).rollNo != data.enteredRollNo
          && data.audience == rosterEntry(email()).addedBy;
      }

      // Lookups: 1 (roster entry). The entry is already bound to a different
      // sign-in.
      function duplicateClaim(data) {
        return hasExactly(data, attemptFields())
          && isRollNo(data.enteredRollNo)
          && hasStudentEmail()
          && rosterEntry(email()).registeredUid != uid()
          && data.audience == rosterEntry(email()).addedBy;
      }

      // The id is rebuilt here from the sender, the type and the server's
      // date. A second alert of the same type on the same day is therefore
      // an update, and no update rule exists: one per account, type and day,
      // whatever date or id the client supplies.
      allow create: if verified()
        && alertId == uid() + '_' + request.resource.data.type + '_' + serverDay()
        && request.resource.data.uid == uid()
        && request.resource.data.email == email()
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.type == 'NON_VJTI_EMAIL'
              && nonVjtiEmail(request.resource.data))
            || (request.resource.data.type == 'NOT_ON_REGISTER'
              && notOnRegister(request.resource.data))
            || (request.resource.data.type == 'ROLL_MISMATCH'
              && rollMismatch(request.resource.data))
            || (request.resource.data.type == 'DUPLICATE_CLAIM'
              && duplicateClaim(request.resource.data)));

      function isAudience() {
        return resource.data.audience == uid() || resource.data.audience == 'ALL';
      }

      // Lookups: 1 (allowlist). Faculty only, and only alerts addressed to
      // them or to all faculty.
      allow read: if signedIn() && isAllowlisted() && isAudience();

      // Retention: kept for at least ALERT_RETENTION_DAYS, then a faculty app
      // may purge it. No update rule exists.
      allow delete: if signedIn()
        && isAllowlisted()
        && isAudience()
        && resource.data.createdAt
            < request.time - duration.value(ALERT_RETENTION_DAYS(), 'd');
    }

    // ---- courses and join codes (invariant 2) ---------------------------
    match /courses/{courseId} {
      function validCourseFields(data) {
        return isText(data.name, 1, 80)
          && isText(data.code, 1, 20)
          && data.threshold is int
          && data.threshold >= THRESHOLD_MIN()
          && data.threshold <= THRESHOLD_MAX();
      }

      function joinCodeAfter(code) {
        return getAfter(/databases/$(database)/documents/joinCodes/$(code)).data;
      }

      // Lookups: 1 (membership), only when the reader is not the owner.
      allow get: if signedIn()
        && (resource.data.teacherId == uid() || isMemberOf(courseId, uid()));

      allow list: if signedIn() && resource.data.teacherId == uid();

      // Lookups: 2 (allowlist, join code after this write). The join code
      // document must be created in the same batch and point back here.
      allow create: if signedIn()
        && isAllowlisted()
        && hasExactly(request.resource.data,
            ['teacherId', 'name', 'code', 'threshold', 'joinCode', 'createdAt'])
        && request.resource.data.teacherId == uid()
        && validCourseFields(request.resource.data)
        && isJoinCode(request.resource.data.joinCode)
        && request.resource.data.createdAt == request.time
        && joinCodeAfter(request.resource.data.joinCode).courseId == courseId;

      // Lookups: 1 (join code after this write). A rename must update the
      // denormalised name on the join code in the same batch.
      allow update: if signedIn()
        && resource.data.teacherId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'threshold'])
        && validCourseFields(request.resource.data)
        && joinCodeAfter(resource.data.joinCode).courseName == request.resource.data.name;
    }

    match /joinCodes/{code} {
      function courseAfter(courseId) {
        return getAfter(/databases/$(database)/documents/courses/$(courseId)).data;
      }

      function validJoinCode(data) {
        return hasExactly(data, ['courseId', 'courseName', 'teacherName', 'teacherId'])
          && isId(data.courseId)
          && courseAfter(data.courseId).teacherId == uid()
          // A student cannot read the course before joining, so the join code
          // is where they learn the teacherId their membership must carry.
          && data.teacherId == courseAfter(data.courseId).teacherId
          && courseAfter(data.courseId).joinCode == code
          && courseAfter(data.courseId).name == data.courseName
          && data.teacherName == request.auth.token.name;
      }

      // get only: listing would let anyone enumerate every course.
      allow get: if signedIn();

      // Lookups: 1 (course after this write). A code that already exists makes
      // this an update, which fails, so codes are unique.
      allow create: if signedIn() && validJoinCode(request.resource.data);

      // Lookups: 1. Only the denormalised course name can follow a rename.
      allow update: if signedIn()
        && validJoinCode(request.resource.data)
        && request.resource.data.courseId == resource.data.courseId;
    }

    // ---- memberships (invariant 3) --------------------------------------
    match /memberships/{membershipId} {
      allow get: if signedIn()
        && (isOwnCompositeId(membershipId) || resource.data.teacherId == uid());

      allow list: if signedIn()
        && (resource.data.studentId == uid() || resource.data.teacherId == uid());

      // Only a registered student can enrol, and the roll number and cohort
      // are the roster's, not something typed at join time.
      function registeredAs(data) {
        let entry = rosterEntry(email());
        return entry.registeredUid == uid()
          && entry.rollNo == data.rollNo
          && entry.cohort == data.cohort;
      }

      // Lookups: 3 (join code, course, roster entry).
      allow create: if signedIn()
        && hasExactly(request.resource.data,
            ['courseId', 'teacherId', 'studentId', 'name', 'email', 'rollNo', 'cohort',
             'joinCode', 'joinedAt'])
        && isId(request.resource.data.courseId)
        && membershipId == request.resource.data.courseId + '_' + uid()
        && request.resource.data.studentId == uid()
        && request.resource.data.teacherId != uid()
        && isJoinCode(request.resource.data.joinCode)
        && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.courseId
            == request.resource.data.courseId
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId
            == request.resource.data.teacherId
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.email == request.auth.token.email
        && registeredAs(request.resource.data)
        && request.resource.data.joinedAt == request.time;
    }

    // ---- sessions and tokens (invariants 4 and 5) -----------------------
    match /sessions/{sessionId} {
      function validGeofence(g) {
        return hasExactly(g, ['lat', 'lng', 'radiusM', 'cosLat'])
          && g.lat is number && g.lat >= -90 && g.lat <= 90
          && g.lng is number && g.lng >= -180 && g.lng <= 180
          && g.radiusM is number
          && g.radiusM >= GEO_RADIUS_MIN_M()
          && g.radiusM <= GEO_RADIUS_MAX_M()
          && g.cosLat is number && g.cosLat > 0 && g.cosLat <= 1;
      }

      // Lookups: 1 (membership), only when the reader is not the teacher.
      allow read: if signedIn()
        && (resource.data.teacherId == uid() || isMemberOf(resource.data.courseId, uid()));

      // Lookups: 1 (course).
      allow create: if signedIn()
        && hasExactly(request.resource.data,
            ['courseId', 'teacherId', 'status', 'startedAt', 'endsAt', 'geofence'])
        && isId(request.resource.data.courseId)
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId == uid()
        && request.resource.data.teacherId == uid()
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt
            >= request.time + duration.value(SESSION_MIN_MIN() - SESSION_SKEW_MIN(), 'm')
        && request.resource.data.endsAt
            <= request.time + duration.value(SESSION_MAX_MIN() + SESSION_SKEW_MIN(), 'm')
        && request.resource.data.geofence is map
        && validGeofence(request.resource.data.geofence);

      // Lookups: 0. The only transition is ACTIVE -> ENDED, and it can never
      // move endsAt later: ending early stamps the server time, closing an
      // already expired session keeps the original end.
      allow update: if signedIn()
        && resource.data.teacherId == uid()
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'ENDED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endsAt'])
        && ((request.time < resource.data.endsAt && request.resource.data.endsAt == request.time)
            || (request.time >= resource.data.endsAt
                && request.resource.data.endsAt == resource.data.endsAt));

      // Lookups: 0. Once a session is over its teacher may record how many
      // people were in the room, and correct it. Only that field changes. A
      // session past its end that nobody closed counts as over.
      allow update: if signedIn()
        && resource.data.teacherId == uid()
        && (resource.data.status == 'ENDED' || request.time >= resource.data.endsAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headcount'])
        && request.resource.data.headcount is int
        && request.resource.data.headcount >= 0
        && request.resource.data.headcount <= HEADCOUNT_MAX();

      match /tokens/{token} {
        function session() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }

        // Lookups: 1 (session). No read, list, update or delete rule exists,
        // so no client can ever see or reuse a token id.
        allow create: if signedIn()
          && isToken(token)
          && hasExactly(request.resource.data, ['validFrom'])
          && request.resource.data.validFrom == request.time
          && session().teacherId == uid()
          && session().status == 'ACTIVE'
          && request.time < session().endsAt;
      }

      // One phone, one student per session. devices/{deviceId} is claimed by
      // the first student who marks from that phone, in the same write as
      // the mark. A second student on the same phone would be an update, and
      // there is no update rule; nor delete, nor list.
      match /devices/{deviceId} {
        // The id is known only to the phone it belongs to, so whoever asks
        // already holds that phone. Lets the app say why a mark is refused.
        allow get: if signedIn();

        // Lookups: 1 (the writer's own mark after the write). The mark names
        // this phone, so a claim cannot exist without its mark.
        allow create: if signedIn()
          && isToken(deviceId)
          && hasExactly(request.resource.data, ['studentId'])
          && request.resource.data.studentId == uid()
          && getAfter(/databases/$(database)/documents/attendance/$(sessionId + '_' + uid())).data.deviceId
              == deviceId;
      }
    }

    // ---- attendance (invariants 6, 7 and 8) -----------------------------
    match /attendance/{attendanceId} {
      function sessionOf(sessionId) {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      function validFromOf(sessionId, token) {
        return get(/databases/$(database)/documents/sessions/$(sessionId)/tokens/$(token)).data.validFrom;
      }

      // Same arithmetic, in the same order, as Geofence.java. No sqrt or trig:
      // squared distances are compared and cosLat is precomputed by the
      // faculty app. float() makes integer and double inputs behave alike.
      function inGeofence(g, lat, lng, accuracyM) {
        let dy = (float(lat) - float(g.lat)) * float(METERS_PER_DEGREE());
        let dx = (float(lng) - float(g.lng)) * float(METERS_PER_DEGREE()) * float(g.cosLat);
        let reach = float(g.radiusM) + float(accuracyM);
        return lat is number && lng is number && accuracyM is number
          && lat >= -90 && lat <= 90
          && lng >= -180 && lng <= 180
          && accuracyM > 0 && accuracyM <= MAX_ACCURACY_M()
          && dx * dx + dy * dy <= reach * reach;
      }

      function studentFields() {
        return ['sessionId', 'courseId', 'teacherId', 'studentId', 'status', 'source',
                'token', 'markedAt', 'lat', 'lng', 'accuracyM', 'deviceId'];
      }

      function liveMark(data, session, validFrom) {
        return hasExactly(data, studentFields())
          && data.source == 'LIVE'
          && data.status == 'PRESENT'
          && session.status == 'ACTIVE'
          && request.time < session.endsAt
          && request.time < validFrom + duration.value(TOKEN_VALIDITY_S(), 's');
      }

      // scannedAt is the device clock at scan time. It is forgeable by a
      // modified client; the window checks bound what a forgery can achieve.
      function queuedMark(data, session, validFrom) {
        return hasExactly(data, studentFields().concat(['scannedAt']))
          && data.source == 'QUEUED'
          && data.status == 'LATE_SYNC'
          && data.scannedAt is timestamp
          && data.scannedAt >= validFrom
          && data.scannedAt < validFrom + duration.value(TOKEN_VALIDITY_S(), 's')
          && data.scannedAt <= request.time
          && data.scannedAt < session.endsAt
          && request.time < session.endsAt + duration.value(QUEUE_GRACE_MIN(), 'm');
      }

      // The claim on this phone for this session, as it will be once the
      // write commits. It must be created in the same write as the mark.
      function deviceClaimAfter(sessionId, deviceId) {
        return getAfter(/databases/$(database)/documents/sessions/$(sessionId)/devices/$(deviceId)).data;
      }

      // Lookups: 4 (session, membership, token, device claim after the write).
      function studentMark(data) {
        let session = sessionOf(data.sessionId);
        let validFrom = validFromOf(data.sessionId, data.token);
        return isId(data.sessionId)
          && isToken(data.token)
          && attendanceId == data.sessionId + '_' + uid()
          && data.studentId == uid()
          && deviceClaimAfter(data.sessionId, data.deviceId).studentId == uid()
          && data.courseId == session.courseId
          && data.teacherId == session.teacherId
          && isMemberOf(session.courseId, uid())
          && data.markedAt == request.time
          && inGeofence(session.geofence, data.lat, data.lng, data.accuracyM)
          && (liveMark(data, session, validFrom) || queuedMark(data, session, validFrom));
      }

      function validCorrection(data) {
        return isText(data.note, 1, NOTE_MAX_LEN())
          && data.updatedBy == uid()
          && data.updatedAt == request.time;
      }

      // Every change a teacher makes is written together with its history
      // entry, attendanceChanges/{recordId}_{revision}, so nothing a teacher
      // does to a record is lost when the note is overwritten.
      function historyWrittenAfter(revision) {
        return existsAfter(/databases/$(database)/documents/attendanceChanges/$(attendanceId + '_' + string(revision)));
      }

      // Lookups: 3 (session, membership, history entry after the write).
      // Absent means "no document", so the only record a teacher can create is
      // MANUAL_PRESENT.
      function manualCreate(data) {
        let session = sessionOf(data.sessionId);
        return hasExactly(data,
            ['sessionId', 'courseId', 'teacherId', 'studentId', 'status', 'source',
             'markedAt', 'note', 'updatedBy', 'updatedAt', 'revision'])
          && isId(data.sessionId)
          && isId(data.studentId)
          && attendanceId == data.sessionId + '_' + data.studentId
          && session.teacherId == uid()
          && data.teacherId == uid()
          && data.courseId == session.courseId
          && isMemberOf(session.courseId, data.studentId)
          && data.status == 'MANUAL_PRESENT'
          && data.source == 'MANUAL'
          && data.markedAt == request.time
          && validCorrection(data)
          && data.revision == 1
          && historyWrittenAfter(1);
      }

      // Lookups: 1 (history entry after the write). teacherId on the document
      // was checked against the session when the document was created and
      // cannot change afterwards. REVOKED marks a scan as a proxy: it carries
      // a penalty, so only a record that came from a scan can be revoked.
      function manualUpdate() {
        return resource.data.teacherId == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'note', 'updatedBy', 'updatedAt', 'revision'])
          && request.resource.data.status in ['MANUAL_PRESENT', 'MANUAL_ABSENT', 'REVOKED']
          && (request.resource.data.status != 'REVOKED'
              || resource.data.source in ['LIVE', 'QUEUED'])
          && validCorrection(request.resource.data)
          && request.resource.data.revision == resource.data.get('revision', 0) + 1
          && historyWrittenAfter(request.resource.data.revision);
      }

      allow get: if signedIn()
        && (isOwnCompositeId(attendanceId) || resource.data.teacherId == uid());

      allow list: if signedIn()
        && (resource.data.studentId == uid() || resource.data.teacherId == uid());

      allow create: if signedIn()
        && (studentMark(request.resource.data) || manualCreate(request.resource.data));

      // Students have no update rule, and nobody has a delete rule: one
      // record per student per session, kept forever.
      allow update: if signedIn() && manualUpdate();
    }

    // ---- attendanceChanges: every change a teacher made to a record --------
    // Written in the same batch as the change, and only then. Never updated or
    // deleted. Readable by the record's teacher and its student.
    match /attendanceChanges/{changeId} {
      function recordPath(recordId) {
        return /databases/$(database)/documents/attendance/$(recordId);
      }

      // Lookups: 3 (record after, record before, its existence before). The
      // entry must describe the change exactly: the status before ('NONE' for
      // a record the change creates), the status and note after, and the
      // record's new revision, which is also the entry's id.
      function validChange(data) {
        let after = getAfter(recordPath(data.recordId)).data;
        return hasExactly(data,
            ['recordId', 'revision', 'teacherId', 'studentId', 'from', 'to', 'note', 'by', 'at'])
          && data.recordId is string
          && data.recordId.matches('^[A-Za-z0-9]+_[A-Za-z0-9]+$')
          && data.revision is int
          && changeId == data.recordId + '_' + string(data.revision)
          && after.revision == data.revision
          && after.teacherId == uid()
          && data.teacherId == uid()
          && data.studentId == after.studentId
          && data.to == after.status
          && data.note == after.note
          && data.by == uid()
          && data.at == request.time
          && (exists(recordPath(data.recordId))
              ? data.from == get(recordPath(data.recordId)).data.status
              : data.from == 'NONE');
      }

      allow read: if signedIn()
        && (resource.data.teacherId == uid() || resource.data.studentId == uid());

      allow create: if signedIn() && validChange(request.resource.data);
    }
  }
}
