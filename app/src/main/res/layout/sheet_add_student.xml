<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_24">

        <include layout="@layout/view_sheet_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:accessibilityHeading="true"
                android:text="@string/add_title"
                android:textAppearance="@style/TextAppearance.Presence.Title" />

            <TextView
                style="@style/Widget.Presence.FieldLabel"
                android:labelFor="@id/add_email"
                android:text="@string/add_email_label" />

            <EditText
                android:id="@+id/add_email"
                style="@style/Widget.Presence.TextField"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="@integer/email_max" />

            <TextView
                android:id="@+id/add_email_error"
                style="@style/Widget.Presence.InlineError"
                android:text="@string/add_email_invalid" />

            <TextView
                style="@style/Widget.Presence.FieldLabel"
                android:labelFor="@id/add_roll"
                android:text="@string/add_roll_label" />

            <EditText
                android:id="@+id/add_roll"
                style="@style/Widget.Presence.TextField"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:fontFeatureSettings="tnum"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="@integer/roll_no_length" />

            <TextView
                android:id="@+id/add_roll_error"
                style="@style/Widget.Presence.InlineError"
                android:text="@string/add_roll_invalid" />

            <TextView
                style="@style/Widget.Presence.FieldLabel"
                android:labelFor="@id/add_name"
                android:text="@string/add_name_label" />

            <EditText
                android:id="@+id/add_name"
                style="@style/Widget.Presence.TextField"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="@integer/name_max" />

            <TextView
                android:id="@+id/add_name_error"
                style="@style/Widget.Presence.InlineError"
                android:text="@string/add_name_invalid" />


            <TextView
                style="@style/Widget.Presence.FieldLabel"
                android:labelFor="@id/add_group"
                android:text="@string/add_group_label" />

            <EditText
                android:id="@+id/add_group"
                style="@style/Widget.Presence.TextField"
                android:autofillHints=""
                android:importantForAutofill="no"
                android:fontFeatureSettings="tnum"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="2" />

            <TextView
                android:id="@+id/add_group_error"
                style="@style/Widget.Presence.InlineError"
                android:text="@string/add_group_invalid" />


            <TextView
                android:id="@+id/add_status"
                style="@style/Widget.Presence.InlineError"
                android:layout_marginTop="@dimen/space_20" />

            <com.presence.attendance.core.ui.SpringButton
                android:id="@+id/add_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/add_submit" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
