<?xml version="1.0" encoding="utf-8"?>
<!-- HOD: who teaches one subject. Every person on the faculty list, and "No teacher". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_24">

    <include layout="@layout/view_sheet_handle" />

    <TextView
        android:id="@+id/teacher_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:accessibilityHeading="true"
        android:paddingHorizontal="@dimen/screen_margin"
        android:textAppearance="@style/TextAppearance.Presence.Title" />

    <TextView
        android:id="@+id/teacher_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:paddingHorizontal="@dimen/screen_margin"
        android:text="@string/teacher_body"
        android:textAppearance="@style/TextAppearance.Presence.Body"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/teacher_status"
        style="@style/Widget.Presence.InlineError"
        android:layout_marginTop="@dimen/space_16"
        android:paddingHorizontal="@dimen/screen_margin" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/teacher_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="@dimen/screen_margin"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
