<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:id="@+id/register_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/register_title"
                android:textAppearance="@style/TextAppearance.Presence.LargeTitle" />

            <!-- The address comes from the sign-in, so it is shown, never typed. -->
            <TextView
                android:id="@+id/register_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.Presence.Body"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/Widget.Presence.FieldLabel"
                android:layout_marginTop="@dimen/space_32"
                android:labelFor="@id/register_roll"
                android:text="@string/add_roll_label" />

            <EditText
                android:id="@+id/register_roll"
                style="@style/Widget.Presence.TextField"
                android:autofillHints=""
                android:background="@drawable/bg_field_on_background"
                android:fontFeatureSettings="tnum"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="@integer/roll_no_length" />

            <TextView
                android:id="@+id/register_roll_error"
                style="@style/Widget.Presence.InlineError"
                android:text="@string/register_roll_invalid" />

            <TextView
                android:id="@+id/register_status"
                style="@style/Widget.Presence.InlineError"
                android:layout_marginTop="@dimen/space_20" />
        </LinearLayout>

        <!-- Bias 1 pins the actions to the bottom when there is room; otherwise they follow the form. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/register_form"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <com.presence.attendance.core.ui.SpringButton
                android:id="@+id/register_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_submit" />

            <com.presence.attendance.core.ui.SpringButton
                android:id="@+id/register_sign_out"
                style="@style/Widget.Presence.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/register_different_account" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
