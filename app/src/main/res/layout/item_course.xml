<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">

    <TextView
        android:id="@+id/course_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Presence.Body" />

    <TextView
        android:id="@+id/course_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.Presence.Footnote"
        android:textColor="@color/text_secondary" />
</LinearLayout>
