<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/sign_in_wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Presence.LargeTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width" />

        <TextView
            android:id="@+id/sign_in_statement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/sign_in_statement"
            android:textAppearance="@style/TextAppearance.Presence.Body"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_in_wordmark"
            app:layout_constraintWidth_max="@dimen/content_max_width" />

        <!-- Bias 1 pins the actions to the bottom when there is room; otherwise they follow the text. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_48"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_in_statement"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:id="@+id/sign_in_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Presence.Footnote"
                android:textColor="@color/danger_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sign_in_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:text="@string/sign_in_in_progress"
                android:textAppearance="@style/TextAppearance.Presence.Footnote"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.presence.attendance.core.ui.SpringButton
                android:id="@+id/sign_in_continue"
                style="@style/Widget.Presence.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_continue_google" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
