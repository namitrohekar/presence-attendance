<?xml version="1.0" encoding="utf-8"?>
<!--
    The name at the top, the university's logo in the middle, the one action at the bottom: three
    blocks spread over the screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:id="@+id/sign_in_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/sign_in_picture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:id="@+id/sign_in_wordmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Presence.Wordmark" />

            <View
                android:layout_width="@dimen/gold_rule_width"
                android:layout_height="@dimen/gold_rule_height"
                android:layout_marginTop="@dimen/space_12"
                android:background="@color/gold" />
        </LinearLayout>

        <!-- The centre of the screen: the university's logo. -->
        <LinearLayout
            android:id="@+id/sign_in_picture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/space_32"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/sign_in_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_in_header"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <!-- VJTI's emblem as the institute prints it, its lines in the theme's ink colour. -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/sign_in_logo"
                android:src="@drawable/vjti_logo"
                app:tint="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sign_in_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_in_picture"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <TextView
                android:id="@+id/sign_in_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Presence.Footnote"
                android:textColor="@color/danger_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sign_in_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:text="@string/sign_in_in_progress"
                android:textAppearance="@style/TextAppearance.Presence.Footnote"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.presence.attendance.core.ui.SpringButton
                android:id="@+id/sign_in_continue"
                style="@style/Widget.Presence.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_continue_google" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
