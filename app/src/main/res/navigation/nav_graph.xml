<?xml version="1.0" encoding="utf-8"?>
<!-- The start destination is chosen in MainActivity from the sign-in state. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.presence.attendance.auth.ui.SignInFragment"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signIn_to_registration"
            app:destination="@id/registrationFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.presence.attendance.auth.ui.RegistrationFragment"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registration_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registrationFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registration_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/registrationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.presence.attendance.course.ui.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_home_to_registration"
            app:destination="@id/registrationFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_home_to_roster"
            app:destination="@id/rosterFragment" />
        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_home_to_saved"
            app:destination="@id/savedScansFragment" />
        <action
            android:id="@+id/action_home_to_alerts"
            app:destination="@id/alertsFragment" />
        <action
            android:id="@+id/action_home_to_course"
            app:destination="@id/courseFragment" />
        <action
            android:id="@+id/action_home_to_live"
            app:destination="@id/liveSessionFragment" />
        <action
            android:id="@+id/action_home_to_scan"
            app:destination="@id/scanFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.presence.attendance.scan.ui.ScanFragment"
        tools:layout="@layout/fragment_scan">
        <!-- The result replaces the scanner, so Back from it returns to the courses. -->
        <action
            android:id="@+id/action_scan_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/scanFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.presence.attendance.scan.ui.ResultFragment"
        tools:layout="@layout/fragment_result">
        <!-- The name of the AppError that rejected the mark; empty when it was marked. -->
        <argument
            android:name="rejection"
            app:argType="string" />
        <action
            android:id="@+id/action_result_to_scan"
            app:destination="@id/scanFragment"
            app:popUpTo="@id/resultFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/courseFragment"
        android:name="com.presence.attendance.session.ui.CourseFragment"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="courseId"
            app:argType="string" />
        <argument
            android:name="courseName"
            app:argType="string" />
        <argument
            android:name="joinCode"
            app:argType="string" />
        <argument
            android:name="threshold"
            app:argType="integer" />
        <action
            android:id="@+id/action_course_to_students"
            app:destination="@id/courseStudentsFragment" />
        <action
            android:id="@+id/action_course_to_live"
            app:destination="@id/liveSessionFragment" />
        <action
            android:id="@+id/action_course_to_session_roster"
            app:destination="@id/sessionRosterFragment" />
    </fragment>

    <fragment
        android:id="@+id/liveSessionFragment"
        android:name="com.presence.attendance.session.ui.LiveSessionFragment"
        tools:layout="@layout/fragment_live_session">
        <argument
            android:name="sessionId"
            app:argType="string" />
        <argument
            android:name="courseName"
            app:argType="string" />
        <!-- Ending a session opens its summary in place of the QR. -->
        <action
            android:id="@+id/action_live_to_session_roster"
            app:destination="@id/sessionRosterFragment"
            app:popUpTo="@id/liveSessionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/rosterFragment"
        android:name="com.presence.attendance.roster.ui.RosterFragment"
        tools:layout="@layout/fragment_list">
        <action
            android:id="@+id/action_roster_to_import"
            app:destination="@id/importFragment" />
    </fragment>

    <fragment
        android:id="@+id/importFragment"
        android:name="com.presence.attendance.roster.ui.ImportFragment"
        tools:layout="@layout/fragment_list" />

    <fragment
        android:id="@+id/alertsFragment"
        android:name="com.presence.attendance.roster.ui.AlertsFragment"
        tools:layout="@layout/fragment_list" />

    <fragment
        android:id="@+id/savedScansFragment"
        android:name="com.presence.attendance.attendance.ui.SavedScansFragment"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="studentId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/sessionRosterFragment"
        android:name="com.presence.attendance.attendance.ui.SessionRosterFragment"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="courseId"
            app:argType="string" />
        <argument
            android:name="sessionId"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.presence.attendance.attendance.ui.HistoryFragment"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="courseId"
            app:argType="string" />
        <argument
            android:name="courseName"
            app:argType="string" />
        <argument
            android:name="threshold"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/courseStudentsFragment"
        android:name="com.presence.attendance.attendance.ui.CourseStudentsFragment"
        tools:layout="@layout/fragment_list">
        <argument
            android:name="courseId"
            app:argType="string" />
        <argument
            android:name="threshold"
            app:argType="integer" />
    </fragment>
</navigation>
