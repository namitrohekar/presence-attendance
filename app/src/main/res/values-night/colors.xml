<?xml version="1.0" encoding="utf-8"?>
<!-- The same ramp at night: deep navy surfaces, ivory text, gold as the accent. -->
<resources>
    <color name="background">#0C0F1C</color>
    <color name="surface">#151A2E</color>
    <color name="fill">#1F2540</color>
    <color name="text">#F1ECDF</color>
    <color name="text_secondary">#A9A28F</color>
    <color name="separator">#262C47</color>

    <!-- Gold reads as the accent on navy; buttons carry dark text on it (10:1). -->
    <color name="accent">#D3B47A</color>
    <color name="on_accent">#10142A</color>
    <color name="gold">#D3B47A</color>

    <color name="success">#5DBB86</color>
    <color name="warning">#E2A94E</color>
    <color name="danger">#F07467</color>
    <color name="danger_text">#FF8A7D</color>

    <color name="google_button_fill">#131314</color>
    <color name="google_button_stroke">#8E918F</color>
    <color name="google_button_text">#E3E3E3</color>
    <!-- Tinted fills behind badge text. The text itself uses the primary text colour (D-006). -->
    <color name="badge_success">#335DBB86</color>
    <color name="badge_warning">#33E2A94E</color>
    <color name="badge_danger">#33F07467</color>

    <color name="tick_disc">#1F2540</color>
    <color name="tick">#D3B47A</color>
</resources>
