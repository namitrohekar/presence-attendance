<?xml version="1.0" encoding="utf-8"?>
<!--
    Heritage academic: ivory paper, Oxford navy ink, a burnished-gold hairline. Surfaces, borders
    and text come from one warm-neutral ramp; navy is the one accent; gold is decoration only (never
    text on a light surface); semantic colours are toned to sit beside them.
-->
<resources>
    <color name="background">#EEE7D9</color>
    <color name="surface">#FFFFFF</color>
    <color name="fill">#ECE5D6</color>
    <color name="text">#171A2B</color>
    <color name="text_secondary">#69634F</color>
    <color name="separator">#E3DACA</color>

    <!-- Oxford navy. 13:1 on ivory, so it carries text and fills under ivory text. -->
    <color name="accent">#1F2A55</color>
    <color name="on_accent">#F8F4EA</color>
    <!-- Burnished gold: hairlines and marks only, 3.6:1 against ivory. -->
    <color name="gold">#9A7840</color>

    <color name="success">#2E7D4F</color>
    <color name="warning">#A6670A</color>
    <color name="danger">#B3362B</color>
    <!-- Body-size error text: the danger fill colour is below WCAG AA at 13sp (decisions.md D-005). -->
    <color name="danger_text">#A12A20</color>

    <!-- Fixed by Google's sign-in branding guidelines, not design tokens. -->
    <color name="google_button_fill">#FFFFFF</color>
    <color name="google_button_stroke">#747775</color>
    <color name="google_button_text">#1F1F1F</color>
    <!-- Tinted fills behind badge text. The text itself uses the primary text colour (D-006). -->
    <color name="badge_success">#1F2E7D4F</color>
    <color name="badge_warning">#24A6670A</color>
    <color name="badge_danger">#21B3362B</color>

    <!-- A QR code is black on white in both themes; scanners need the contrast. -->
    <color name="qr_light">#FFFFFF</color>
    <color name="qr_dark">#000000</color>

    <!-- Over the camera preview, in both themes: light controls on a dark, solid scrim. -->
    <color name="scan_scrim">#99000000</color>
    <color name="scan_on_scrim">#FFFFFF</color>

    <!-- The app mark: navy and gold, the same in both themes. -->
    <color name="brand_ink">#1F2A55</color>
    <color name="brand_paper">#F8F4EA</color>
    <color name="brand_gold">#C9A66B</color>

    <!-- The result: a gold tick on a navy seal, in both themes (6:1). -->
    <color name="tick_disc">#1F2A55</color>
    <color name="tick">#C9A66B</color>
</resources>
