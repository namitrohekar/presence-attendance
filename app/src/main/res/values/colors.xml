<?xml version="1.0" encoding="utf-8"?>
<!--
    Paper and blue-black ink: the college register. One cool graphite ramp for every surface,
    border and text role, one ink accent used rarely, semantic colours toned to sit beside it.
-->
<resources>
    <color name="background">#F3F4F6</color>
    <color name="surface">#FFFFFF</color>
    <color name="fill">#ECEEF1</color>
    <color name="text">#15171C</color>
    <color name="text_secondary">#5C616B</color>
    <color name="separator">#E1E3E8</color>

    <!-- Register ink. 7.6:1 on white, so it works as text and as a fill under white text. -->
    <color name="accent">#2B45C4</color>
    <color name="on_accent">#FFFFFF</color>

    <color name="success">#1E8A4F</color>
    <color name="warning">#B26B00</color>
    <color name="danger">#D23A2D</color>
    <!-- Body-size error text: the danger fill colour is below WCAG AA at 13sp (decisions.md D-005). -->
    <color name="danger_text">#B3241B</color>

    <!-- Fixed by Google's sign-in branding guidelines, not design tokens. -->
    <color name="google_button_fill">#FFFFFF</color>
    <color name="google_button_stroke">#747775</color>
    <color name="google_button_text">#1F1F1F</color>
    <!-- Tinted fills behind badge text. The text itself uses the primary text colour (D-006). -->
    <color name="badge_success">#1F1E8A4F</color>
    <color name="badge_warning">#24B26B00</color>
    <color name="badge_danger">#21D23A2D</color>

    <!-- A QR code is black on white in both themes; scanners need the contrast. -->
    <color name="qr_light">#FFFFFF</color>
    <color name="qr_dark">#000000</color>

    <!-- Over the camera preview, in both themes: light controls on a dark, solid scrim. -->
    <color name="scan_scrim">#99000000</color>
    <color name="scan_on_scrim">#FFFFFF</color>

    <!-- The app mark: ink and paper, the same in both themes. -->
    <color name="brand_ink">#2B45C4</color>
    <color name="brand_paper">#FFFFFF</color>

    <!-- The ink tick on the result screen sits on a paper disc in both themes. -->
    <color name="tick_disc">#EAEDF8</color>
</resources>
