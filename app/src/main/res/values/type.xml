<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Presence" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Presence.Semibold">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.Presence.LargeTitle" parent="TextAppearance.Presence.Semibold">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:lineHeight">@dimen/line_large_title</item>
    </style>

    <style name="TextAppearance.Presence.Title" parent="TextAppearance.Presence.Semibold">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:lineHeight">@dimen/line_title</item>
    </style>

    <style name="TextAppearance.Presence.Headline" parent="TextAppearance.Presence.Semibold">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:lineHeight">@dimen/line_headline</item>
    </style>

    <style name="TextAppearance.Presence.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineHeight">@dimen/line_body</item>
    </style>

    <style name="TextAppearance.Presence.Subhead">
        <item name="android:textSize">@dimen/text_subhead</item>
        <item name="android:lineHeight">@dimen/line_subhead</item>
    </style>

    <style name="TextAppearance.Presence.Footnote">
        <item name="android:textSize">@dimen/text_footnote</item>
        <item name="android:lineHeight">@dimen/line_footnote</item>
    </style>

    <style name="TextAppearance.Presence.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineHeight">@dimen/line_caption</item>
    </style>

    <!-- Codes and numbers: tabular figures so digits line up and do not shift. -->
    <style name="TextAppearance.Presence.Code" parent="TextAppearance.Presence.LargeTitle">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Google's guidelines fix this label to Roboto Medium 14/20. -->
    <style name="TextAppearance.Presence.GoogleButton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/google_button_text</item>
        <item name="android:lineHeight">@dimen/google_button_line</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
